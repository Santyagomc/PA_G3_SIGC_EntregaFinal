DB_NAME=sigcapi
DB_PORT=3307
DB_USER=sigc_user
DB_PASSWORD=segura_cambiar_123
DB_ROOT_PASSWORD=root_cambiar_123
JWT_SECRET=change-this-development-secret-key-with-at-least-32-characters
STORAGE_PATH=/app/storage/documents
# Administrador inicial (solo desarrollo; cambie estos valores en un despliegue real)
ADMIN_DOCUMENT=1000000001
ADMIN_PASSWORD=Admin.12345
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Administrador SIGC"
# --- Kafka (Entrega 2 P2)
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8090
KAFKA_TOPIC_REQUEST_EVENTS=audit-events
KAFKA_TOPIC_REQUEST_EVENTS_DLT=audit-events.DLT
API_PORT=8080
# --- Notificaciones: false = modo SIMULADO (el consumidor registra el correo sin enviarlo)
MAIL_ENABLED=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
# --- Entrega final (P3): gateway GraphQL, Redis, frontend y seguridad
GATEWAY_PORT=8081
FRONTEND_PORT=4300
# Orígenes que el navegador puede usar contra la API y el gateway (CORS explícito, nunca "*")
CORS_ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4200
# Resiliencia del gateway frente a la API REST (milisegundos)
API_CONNECT_TIMEOUT_MS=2000
API_READ_TIMEOUT_MS=5000
# Opcional: chatbot con Anthropic (vacío = funcionalidad de chatbot no disponible)
ANTHROPIC_API_KEY=
