{
  "info": {
    "name": "API Documental - Evidencias",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Orden de ejecución: 1 → 2 → 3 → 4 → 5 → 7. El punto 6 (pruebas Maven) se ejecuta en terminal: cd api.documental && bash mvnw test"
  },
  "item": [
    {
      "name": "1. Registro de ciudadano",
      "item": [
        {
          "name": "POST /auth/register → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ciudadano Prueba\",\n  \"email\": \"ciudadano.prueba@example.com\",\n  \"document\": \"1075000001\",\n  \"password\": \"Clave123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Login",
      "item": [
        {
          "name": "POST /auth/login (ciudadano) → 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{citizenDocument}}\",\n  \"password\": \"{{citizenPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK',()=>pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const t = (j.data && j.data.token) || j.token || j.accessToken || j.jwt;",
                  "if (t) pm.collectionVariables.set('citizenToken', t);",
                  "console.log('Token (recortado):', t ? t.substring(0,25)+'...' : 'no encontrado');"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login (administrador) → 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{adminDocument}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK',()=>pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const t = (j.data && j.data.token) || j.token || j.accessToken || j.jwt;",
                  "if (t) pm.collectionVariables.set('adminToken', t);",
                  "console.log('Token (recortado):', t ? t.substring(0,25)+'...' : 'no encontrado');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Radicar PQR",
      "item": [
        {
          "name": "POST /requests/save (multipart) → 201",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{citizenToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "request",
                  "value": "{\"title\": \"Solicitud de ejemplo\", \"description\": \"Descripción de la PQR para evidencia\", \"type\": \"PETICION\"}",
                  "type": "text",
                  "contentType": "application/json"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/requests/save",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "save"
              ]
            },
            "description": "En 'files' seleccione al menos un archivo (PDF/imagen) desde su equipo antes de enviar. Ajuste los campos de la parte 'request' según RequestDTO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
